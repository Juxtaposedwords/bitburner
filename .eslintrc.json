{
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended"
    ],
    "overrides": [
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "ignorePatterns": [
        "node_modules/**",
        "build/**",
        "dist/**",
        "NetscriptDefinitions.d.ts"
    ],
"rules": {
    "id-denylist": [
      "error",
      
      // Basic Hacking (These add up quickly in parallel scripts)
      "hack",
      "grow",
      "weaken",
      "share",     

      // Heavy Minigames & End-Game APIs
      "attempt",   // codingcontract (10 GB)
      "sleeve",    // (4.0 GB)
      "stanek",    
      "gang",      
      "corporation", 
      "bladeburner",
      "stock",
      "hacknet"
    ]
  }
}
